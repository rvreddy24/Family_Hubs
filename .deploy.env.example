# Copy to `.deploy.env` (gitignored) and fill in, then run: npm run deploy:auto
# This deploys the Cloudflare Worker with no interactive browser login.

# Cloudflare API token with the "Edit Cloudflare Workers" permission.
# Create at: dashboard -> My Profile -> API Tokens -> Create Token.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Supabase (Project Settings -> API). service_role key is server-side only.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_KEY=

# A long random string you choose; guards POST /spaces.
ADMIN_SECRET=
